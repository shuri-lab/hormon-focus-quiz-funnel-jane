# Where the email gate posts. A Klaviyo proxy, a Shopify app endpoint, or a
# serverless function — anything that accepts a JSON POST. See src/lib/leads.ts.
#
# LEAVE THIS UNSET AND EVERY ADDRESS COLLECTED IS DROPPED. It is the one thing
# that must be wired before a single ad runs.
VITE_LEAD_ENDPOINT=

# Microsoft Clarity project ID. OPTIONAL OVERRIDE — the real project is
# committed in src/lib/analytics.ts, so Clarity runs whether or not this is
# set. Set it only to record into a different project, e.g. a throwaway one
# while testing, so you are not writing noise into the live recordings.
VITE_CLARITY_ID=
